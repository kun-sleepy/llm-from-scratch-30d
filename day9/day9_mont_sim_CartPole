import torch, torch.nn as nn, gymnasium as gym

# 1. 搭建大脑（策略网络）
policy = nn.Sequential(nn.Linear(4, 64), nn.ReLU(), nn.Linear(64, 2))   

# 2. 聘请脑科医生（优化器）
opt = torch.optim.Adam(policy.parameters(), lr=1e-2)

# 3. 买一台游戏机（环境）
env = gym.make("CartPole-v1")



def rollout():
    obs, _ = env.reset()
    logps, rewards = [], []

    for t in range(500):
        s = torch.tensor(obs, dtype=torch.float32)
        dist = torch.distributions.Categorical(logits=policy(s))
        a = dist.sample()
        logps.append(dist.log_prob(a))     

        obs, r, done, trunc, _ = env.step(a.item())
        rewards.append(r)
        
        if done or trunc: break
    return logps, rewards


for episode in range(300):
    logps, rewards = rollout()
    # 蒙特卡洛回报 G_t（无折扣版，γ=1）
    G, returns = 0, []
    for r in reversed(rewards):
        G = r + G; returns.insert(0, G)
    returns = torch.tensor(returns)
    returns = (returns - returns.mean()) / (returns.std() + 1e-8)   # 基线归一化：减方差！
    loss = -torch.stack(logps).mul(returns).mean()   # 策略梯度（负号：梯度上升变下降）
    opt.zero_grad(); loss.backward(); opt.step()
    if episode % 30 == 0:
        print(f"ep {episode}: 存活 {len(rewards)} 步")




